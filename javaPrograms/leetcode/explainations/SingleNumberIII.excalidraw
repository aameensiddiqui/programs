    {
      "id": "XMIOJhKWa6vdZMZoRNKS2",
      "type": "text",
      "x": 904.5555555555558,
      "y": 60.055555555555515,
      "width": 239.3009796142578,
      "height": 332.2222222222222,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1366564755,
      "version": 867,
      "versionNonce": 1908967165,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "FBsmbMWOinHgpkD11NTTc",
          "type": "arrow"
        }
      ],
      "updated": 1775412443855,
      "link": null,
      "locked": false,
      "text": "LOGIC FOR LEAST SIGNIFICANT BIT :\n\nwe know when you xor:\n\n1 ^ 1 = 0\n0 ^ 0 = 0\n1 ^ 0 = 1\n0 ^ 1 = 1\n\nso by logic if same number is to be xored with itself,\nwe will get ZERO as answer.\ne.g. 1\n5 ^ 5 = 0\nin binary 5 is 101\nso,     1 0 1\n      ^  1 0 1\n-----------------\n           0 0 0\n\ne.g. 2\n3 ^ 4 != 0\n3 = 011, 4 = 100\nso,     0  1  1\n       ^ 1  0  0\n------------------\n          1   1  1",
      "fontSize": 10.22222222222222,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LOGIC FOR LEAST SIGNIFICANT BIT :\n\nwe know when you xor:\n\n1 ^ 1 = 0\n0 ^ 0 = 0\n1 ^ 0 = 1\n0 ^ 1 = 1\n\nso by logic if same number is to be xored with itself,\nwe will get ZERO as answer.\ne.g. 1\n5 ^ 5 = 0\nin binary 5 is 101\nso,     1 0 1\n      ^  1 0 1\n-----------------\n           0 0 0\n\ne.g. 2\n3 ^ 4 != 0\n3 = 011, 4 = 100\nso,     0  1  1\n       ^ 1  0  0\n------------------\n          1   1  1",
      "autoResize": true,
      "lineHeight": 1.25
    },
