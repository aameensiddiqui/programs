    {
      "id": "QbyxWcoAzq7qChcSsRDkI",
      "type": "text",
      "x": 932.8888888888887,
      "y": 861.4444444444446,
      "width": 346.51947021484375,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 1058598941,
      "version": 1339,
      "versionNonce": 849079443,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775415858647,
      "link": null,
      "locked": false,
      "text": "int a = 0;\nint b = 0;\nbit_diff = 7 = 111\nfor (int num : nums) {\n    if ((bit_diff & num) != 0) a = a ^ num;\n    else b = b ^ num;\n}\n\n|||-\nfor & operator we know,\n1 1 -- 1\n1 0 -- 0\n0 1 -- 0\n0 0 -- 0\n-|||\n\ni = 0\n1 & 1 != 0 ->true\na = 0 ^ 1 = 1\n\ni = 1                               000\n2 & 1 != 0 ->false     ^  010\nb = 0 ^ 2 = 2             --------\n                                       010\n\ni = 2\n1 & 1 != 0 ->true\na = 1 ^ 1 = 0",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int a = 0;\nint b = 0;\nbit_diff = 7 = 111\nfor (int num : nums) {\n    if ((bit_diff & num) != 0) a = a ^ num;\n    else b = b ^ num;\n}\n\n|||-\nfor & operator we know,\n1 1 -- 1\n1 0 -- 0\n0 1 -- 0\n0 0 -- 0\n-|||\n\ni = 0\n1 & 1 != 0 ->true\na = 0 ^ 1 = 1\n\ni = 1                               000\n2 & 1 != 0 ->false     ^  010\nb = 0 ^ 2 = 2             --------\n                                       010\n\ni = 2\n1 & 1 != 0 ->true\na = 1 ^ 1 = 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7ku56jPTUzi4J5avHiche",
      "type": "text",
      "x": 1250.6666666666658,
      "y": 1159.2222222222215,
      "width": 284.31964111328125,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 352332595,
      "version": 219,
      "versionNonce": 1164768083,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775416581589,
      "link": null,
      "locked": false,
      "text": "i = 3                                010\n3 & 1 != 0 ->true        ^ 011\na = 0 ^ 3 = 3             ----------\n                                        001\n\ni = 4                                 010\n2 & 1 != 0->false        ^  001\nb = 2 ^ 2 = 0             -----------\n                                          011\n\n\ni = 5                                 011\n5 & 1 != 0->false        ^ 101\na = 3 ^ 5 = 6             ------------\n                                        110",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i = 3                                010\n3 & 1 != 0 ->true        ^ 011\na = 0 ^ 3 = 3             ----------\n                                        001\n\ni = 4                                 010\n2 & 1 != 0->false        ^  001\nb = 2 ^ 2 = 0             -----------\n                                          011\n\n\ni = 5                                 011\n5 & 1 != 0->false        ^ 101\na = 3 ^ 5 = 6             ------------\n                                        110",
      "autoResize": true,
      "lineHeight": 1.25
    },
