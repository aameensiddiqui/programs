      "text": "i  = 3\nxor = 2 ^ 3 = 1\n010\n011\n-----\n001\n\ni  = 4\nxor = 1 ^ 2 = 3\n001\n010\n-----\n011\n\ni  = 5\nxor = 3 ^ 5 = 6\n011\n101\n-----\n110\n",
      "fontSize": 10.94179894179894,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i  = 3\nxor = 2 ^ 3 = 1\n010\n011\n-----\n001\n\ni  = 4\nxor = 1 ^ 2 = 3\n001\n010\n-----\n011\n\ni  = 5\nxor = 3 ^ 5 = 6\n011\n101\n-----\n110\n",
      "autoResize": true,
